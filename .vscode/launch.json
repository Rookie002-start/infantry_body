        {
            "name": "HPM5361 调试 (J-Link JTAG)",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/build/zephyr/zephyr.elf",
            "MIMode": "gdb",
            "miDebuggerPath": "/home/rookie/zephyrproject/zephyr-sdk-1.0.1/gnu/riscv64-zephyr-elf/bin/riscv64-zephyr-elf-gdb",
            "miDebuggerServerAddress": "localhost:3333",
            "debugServerPath": "/home/rookie/openocd-hpm/bin/openocd",
            "debugServerArgs": "-s /home/rookie/Zephyr_HPMicro/sdk_env/hpm_sdk/boards/openocd -s /home/rookie/Zephyr_HPMicro/sdk_glue_user/boards/openocd -f ${workspaceFolder}/boards/hpm/hpm5361icb/openocd-debug.cfg",
            "serverStarted": "Listening on port .* for gdb connections",
            "serverLaunchTimeout": 30000,
            "filterStderr": true,
            "setupCommands": [
                {
                    "description": "复位 + 使能时钟，并停住 CPU",
                    "text": "monitor reset init",
                    "ignoreFailures": true
                },
                {
                    "description": "开启 gdb pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "launchCompleteCommand": "exec-continue",
            "externalConsole": false
        },
